# ============================================================
# متغيّرات البيئة — انسخ هذا الملف إلى .env.local واملأ القيم
# ============================================================
# ملاحظة أمنية: .env.local غير مرفوع إلى GitHub (مستثنى في .gitignore).
# لا تضع هنا أبدًا Service Role Key ولا أي مفتاح سرّي — الواجهة عامة.

# عنوان مشروع Supabase (Project URL) — يظهر في Settings ← API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# المفتاح العام (anon / publishable) — آمن للواجهة لأنه محمي بـ RLS
VITE_SUPABASE_ANON_KEY=<anon-key>

# مفتاح VAPID العام لإشعارات الويب (Push) — يعمل والتطبيق مغلق
# المفتاح الخاص يُخزَّن كسرّ في Supabase Edge Functions باسم VAPID_PRIVATE_KEY
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>
